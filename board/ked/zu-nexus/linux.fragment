# ============ KED ZU-NEXUS-AI: pipeline video IMX219 ============
CONFIG_MEDIA_SUPPORT=y
CONFIG_MEDIA_CONTROLLER=y
CONFIG_MEDIA_CAMERA_SUPPORT=y
CONFIG_MEDIA_PLATFORM_SUPPORT=y
CONFIG_V4L_PLATFORM_DRIVERS=y
CONFIG_VIDEO_V4L2_SUBDEV_API=y
CONFIG_VIDEO_XILINX=y
CONFIG_VIDEO_XILINX_CSI2RXSS=y
CONFIG_VIDEO_XILINX_DEMOSAIC=y
CONFIG_VIDEO_XILINX_GAMMA=y
CONFIG_VIDEO_XILINX_VPSS_CSC=y
CONFIG_VIDEO_XILINX_VPSS_SCALER=y
CONFIG_XILINX_FRMBUF=y
CONFIG_DMADEVICES=y
# sensore
CONFIG_VIDEO_IMX219=y
# reset via AXI GPIO e I2C AXI della camera
CONFIG_GPIO_XILINX=y
CONFIG_I2C_XILINX=y

# ============ DisplayPort + GPU ============
CONFIG_DRM=y
CONFIG_DRM_ZYNQMP_DPSUB=y
CONFIG_XILINX_ZYNQMP_DPDMA=y
CONFIG_PHY_XILINX_ZYNQMP=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_LIMA=y
# memoria contigua per piani DP, frmbuf e GPU
CONFIG_CMA=y
CONFIG_DMA_CMA=y
CONFIG_CMA_SIZE_MBYTES=256

# ============ PCIe per DX-M1 (root port PS) ============
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_PCIE_XILINX_NWL=y

# ============ monitor di corrente/potenza INA231 ============
# Due INA231AIYFF sul bus PS I2C1 (vedi zynqmp-ked-zcu-revA.dts):
#   @0x40 -> ramo 5V di sistema      @0x41 -> ramo 3V3 del connettore M.2 (DX-M1)
# shunt 20 mOhm. Il driver ina2xx copre anche ina231 e li espone come hwmon
# (in1_input, curr1_input, power1_input): e' cosi' che dxpose-qt legge gli
# assorbimenti. Senza SENSORS_INA2XX i nodi DT vengono ignorati e non compare
# nessun /sys/class/hwmon/hwmonN con name=ina231.
CONFIG_I2C=y
CONFIG_I2C_CADENCE=y
CONFIG_HWMON=y
CONFIG_SENSORS_INA2XX=y

# ============ debug (richiesto per diagnosi V4L2/link validation) ============
CONFIG_DYNAMIC_DEBUG=y
CONFIG_DEBUG_FS=y

# ============ dma-buf userspace ============
# /dev/udmabuf (dmabuf da memfd) + heaps CMA/system per buffer condivisi
CONFIG_MEMFD_CREATE=y
CONFIG_UDMABUF=y
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y
CONFIG_DMABUF_HEAPS_CMA=y

# ============ logo di boot (KED, via fbcon) ============
CONFIG_LOGO=y
CONFIG_LOGO_LINUX_CLUT224=y
# CONFIG_LOGO_LINUX_MONO is not set
# CONFIG_LOGO_LINUX_VGA16 is not set
